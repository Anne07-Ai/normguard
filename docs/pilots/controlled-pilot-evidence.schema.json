{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Anne07-Ai/normguard/docs/pilots/controlled-pilot-evidence.schema.json",
  "title": "NormGuard controlled-pilot evidence envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["record", "record_sha256"],
  "properties": {
    "record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "protocol", "decision", "approved_scope",
        "data_classification", "sealed_data_status", "identities", "counts",
        "metrics", "budgets", "gates", "limitations"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "protocol": {"const": "NG-PILOT-001"},
        "decision": {"enum": ["PASS", "STOP"]},
        "approved_scope": {"const": "controlled-offline-or-single-tenant-library-pilot"},
        "data_classification": {"enum": ["synthetic", "organization-approved"]},
        "sealed_data_status": {"const": "development-and-official-test-not-read-or-transformed"},
        "identities": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source_commit", "artifact_sha256", "policy_sha256", "configuration_sha256", "corpus_sha256"],
          "properties": {
            "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "configuration_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "corpus_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        },
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cases", "success", "review_required", "functional_mismatches", "determinism_mismatches", "unauthorized_transformations"],
          "properties": {
            "cases": {"type": "integer", "minimum": 0},
            "success": {"type": "integer", "minimum": 0},
            "review_required": {"type": "integer", "minimum": 0},
            "functional_mismatches": {"type": "integer", "minimum": 0},
            "determinism_mismatches": {"type": "integer", "minimum": 0},
            "unauthorized_transformations": {"type": "integer", "minimum": 0}
          }
        },
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "required": ["exact_identifier_retention", "latency_p95_ms", "throughput_per_second"],
          "properties": {
            "exact_identifier_retention": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
            "latency_p95_ms": {"type": "number", "minimum": 0},
            "throughput_per_second": {"type": "number", "minimum": 0}
          }
        },
        "budgets": {
          "type": "object",
          "additionalProperties": false,
          "required": ["latency_p95_ms", "minimum_throughput_per_second"],
          "properties": {
            "latency_p95_ms": {"type": "number", "exclusiveMinimum": 0},
            "minimum_throughput_per_second": {"type": "number", "exclusiveMinimum": 0}
          }
        },
        "gates": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name", "status", "owner", "hard_gate", "evidence"],
            "properties": {
              "id": {"type": "string", "pattern": "^G-[0-9]{2}$"},
              "name": {"type": "string"},
              "status": {"enum": ["PASS", "FAIL", "NOT_APPLICABLE"]},
              "owner": {"type": "string"},
              "hard_gate": {"type": "boolean"},
              "evidence": {"type": "array", "items": {"type": "string"}}
            }
          }
        },
        "limitations": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
