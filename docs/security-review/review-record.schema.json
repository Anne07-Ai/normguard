{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Anne07-Ai/normguard/docs/security-review/review-record.schema.json",
  "title": "NormGuard independent security review record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "review_status", "scope", "reviewers", "threat_coverage", "findings", "conclusion", "sign_off"],
  "properties": {
    "schema_version": {"const": 1},
    "review_status": {"enum": ["NOT_STARTED", "IN_PROGRESS", "COMPLETED"]},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "source_commit", "artifact_sha256", "review_boundary"],
      "properties": {
        "component": {"const": "normguard-safety-core"},
        "source_commit": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
        "artifact_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "review_boundary": {"const": "offline-or-single-tenant-library-core"}
      }
    },
    "reviewers": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reviewer_id", "organization", "role", "independence_statement", "conflicts"],
        "properties": {
          "reviewer_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "organization": {"type": "string", "minLength": 1, "maxLength": 128},
          "role": {"type": "string", "minLength": 1, "maxLength": 128},
          "independence_statement": {"type": "string", "minLength": 1, "maxLength": 1000},
          "conflicts": {"type": "array", "maxItems": 16, "items": {"type": "string", "minLength": 1, "maxLength": 256}}
        }
      }
    },
    "threat_coverage": {
      "type": "array",
      "maxItems": 24,
      "uniqueItems": true,
      "allOf": [
        {"contains": {"properties": {"threat_id": {"const": "NG-T01"}}, "required": ["threat_id"]}},
        {"contains": {"properties": {"threat_id": {"const": "NG-T02"}}, "required": ["threat_id"]}},
        {"contains": {"properties": {"threat_id": {"const": "NG-T03"}}, "required": ["threat_id"]}},
        {"contains": {"properties": {"threat_id": {"const": "NG-T04"}}, "required": ["threat_id"]}},
        {"contains": {"properties": {"threat_id": {"const": "NG-T05"}}, "required": ["threat_id"]}},
        {"contains": {"properties": {"threat_id": {"const": "NG-T06"}}, "required": ["threat_id"]}},
        {"contains": {"properties": {"threat_id": {"const": "NG-T07"}}, "required": ["threat_id"]}},
        {"contains": {"properties": {"threat_id": {"const": "NG-T08"}}, "required": ["threat_id"]}},
        {"contains": {"properties": {"threat_id": {"const": "NG-T09"}}, "required": ["threat_id"]}},
        {"contains": {"properties": {"threat_id": {"const": "NG-T10"}}, "required": ["threat_id"]}},
        {"contains": {"properties": {"threat_id": {"const": "NG-T11"}}, "required": ["threat_id"]}},
        {"contains": {"properties": {"threat_id": {"const": "NG-T12"}}, "required": ["threat_id"]}},
        {"contains": {"properties": {"threat_id": {"const": "NG-T13"}}, "required": ["threat_id"]}},
        {"contains": {"properties": {"threat_id": {"const": "NG-T14"}}, "required": ["threat_id"]}},
        {"contains": {"properties": {"threat_id": {"const": "NG-T15"}}, "required": ["threat_id"]}},
        {"contains": {"properties": {"threat_id": {"const": "NG-T16"}}, "required": ["threat_id"]}},
        {"contains": {"properties": {"threat_id": {"const": "NG-T17"}}, "required": ["threat_id"]}},
        {"contains": {"properties": {"threat_id": {"const": "NG-T18"}}, "required": ["threat_id"]}},
        {"contains": {"properties": {"threat_id": {"const": "NG-T19"}}, "required": ["threat_id"]}},
        {"contains": {"properties": {"threat_id": {"const": "NG-T20"}}, "required": ["threat_id"]}},
        {"contains": {"properties": {"threat_id": {"const": "NG-T21"}}, "required": ["threat_id"]}},
        {"contains": {"properties": {"threat_id": {"const": "NG-T22"}}, "required": ["threat_id"]}},
        {"contains": {"properties": {"threat_id": {"const": "NG-T23"}}, "required": ["threat_id"]}},
        {"contains": {"properties": {"threat_id": {"const": "NG-T24"}}, "required": ["threat_id"]}}
      ],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["threat_id", "outcome", "evidence_refs"],
        "properties": {
          "threat_id": {"pattern": "^NG-T(0[1-9]|1[0-9]|2[0-4])$"},
          "outcome": {"enum": ["VERIFIED", "FINDING", "NOT_VERIFIED"]},
          "evidence_refs": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 256}}
        }
      }
    },
    "findings": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["finding_id", "title", "severity", "threat_ids", "status", "evidence_refs", "remediation", "risk_acceptance"],
        "properties": {
          "finding_id": {"pattern": "^SR-[0-9]{3}$"},
          "title": {"type": "string", "minLength": 1, "maxLength": 160},
          "severity": {"enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "INFORMATIONAL"]},
          "threat_ids": {"type": "array", "minItems": 1, "maxItems": 24, "items": {"pattern": "^NG-T(0[1-9]|1[0-9]|2[0-4])$"}},
          "status": {"enum": ["OPEN", "REMEDIATED", "RISK_ACCEPTED", "BLOCKING"]},
          "evidence_refs": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
          "remediation": {"type": ["string", "null"], "maxLength": 2000},
          "risk_acceptance": {
            "oneOf": [
              {"type": "null"},
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["authority_id", "rationale", "expires_on"],
                "properties": {
                  "authority_id": {"type": "string", "minLength": 1, "maxLength": 128},
                  "rationale": {"type": "string", "minLength": 1, "maxLength": 2000},
                  "expires_on": {"type": "string", "format": "date"}
                }
              }
            ]
          }
        },
        "allOf": [
          {
            "if": {"properties": {"status": {"const": "RISK_ACCEPTED"}}},
            "then": {"properties": {"risk_acceptance": {"type": "object"}}},
            "else": {"properties": {"risk_acceptance": {"type": "null"}}}
          }
        ]
      }
    },
    "conclusion": {"type": ["string", "null"], "enum": [null, "PASS", "PASS_WITH_ACCEPTED_RISK", "FAIL"]},
    "sign_off": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["reviewer_id", "signed_at", "record_sha256", "signature_reference"],
          "properties": {
            "reviewer_id": {"type": "string", "minLength": 1, "maxLength": 128},
            "signed_at": {"type": "string", "format": "date-time"},
            "record_sha256": {"pattern": "^[0-9a-f]{64}$"},
            "signature_reference": {"type": "string", "minLength": 1, "maxLength": 256}
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"review_status": {"const": "COMPLETED"}}},
      "then": {"properties": {"reviewers": {"minItems": 1}, "threat_coverage": {"minItems": 24, "maxItems": 24}, "conclusion": {"type": "string"}, "sign_off": {"type": "object"}}},
      "else": {"properties": {"conclusion": {"type": "null"}, "sign_off": {"type": "null"}}}
    }
  ]
}
